# Copy to .env and adjust. Demo mode needs nothing else.
PLEXUS_DEMO_MODE=true
PLEXUS_DB_PATH=studio.db

# --- set DEMO_MODE=false and fill these to use real connectors ---

# Bedrock
PLEXUS_AWS_REGION=us-east-1
PLEXUS_BEDROCK_DEFAULT_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0

# Neo4j
PLEXUS_NEO4J_URI=bolt://localhost:7687
PLEXUS_NEO4J_USER=neo4j
PLEXUS_NEO4J_PASSWORD=
PLEXUS_NEO4J_DATABASE=neo4j

# Trino
PLEXUS_TRINO_HOST=localhost
PLEXUS_TRINO_PORT=8080
PLEXUS_TRINO_SCHEME=https
PLEXUS_TRINO_CATALOG=hive
