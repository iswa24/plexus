# Copy to .env and adjust. Demo mode needs nothing else.
# Full go-live walkthrough: ../docs/GO-LIVE.md
PLEXUS_DEMO_MODE=true
PLEXUS_DB_PATH=studio.db
PLEXUS_CORS_ORIGINS=*                       # lock to your domain in production

# ============================================================================
# Set PLEXUS_DEMO_MODE=false and fill the sections you use to go live.
# Connector SDKs are imported lazily — install only what you need.
# ============================================================================

# --- AI provider: AI Agent / NL→SQL / Classifier / Detection / Graph / RAG nodes ---
# Per node you choose: bedrock | azure | anthropic | claudecode
# NL→SQL default provider when a node doesn't set one:
PLEXUS_NL2SQL_PROVIDER=claudecode          # claudecode | anthropic | bedrock | azure

# Bedrock (AWS; auth via the standard AWS credential chain — no key here)
PLEXUS_AWS_REGION=us-east-1
PLEXUS_BEDROCK_DEFAULT_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0

# Anthropic (direct API)
PLEXUS_ANTHROPIC_API_KEY=sk-ant-...
PLEXUS_ANTHROPIC_MODEL=claude-sonnet-4-5

# Azure OpenAI — auth is either a key OR Entra ID / managed identity (enterprise,
# enables OBO): set azure_use_entra=true and leave the key blank.
PLEXUS_AZURE_ENDPOINT=https://<resource>.openai.azure.com/
PLEXUS_AZURE_API_KEY=
PLEXUS_AZURE_API_VERSION=2024-10-21
PLEXUS_AZURE_DEPLOYMENT=gpt-4o             # deployment name = model id
PLEXUS_AZURE_USE_ENTRA=false

# --- NL2SQL local SQLite databases (demo/dev; seed: python scripts/seed_security.py) ---
PLEXUS_INCIDENTS_DB=data/incidents.db
PLEXUS_ASSETS_DB=data/assets.db

# --- Trino: DEFAULT cluster (fallback for nodes with no connectionId) ---------
# Multiple remote clients are added in the UI (⋯ More → Connections & Settings) or
# via POST /api/connections — those are the primary path. See docs/GO-LIVE.md §5.
PLEXUS_TRINO_HOST=localhost
PLEXUS_TRINO_PORT=8080
PLEXUS_TRINO_SCHEME=https                   # use http only for a local dev cluster
PLEXUS_TRINO_CATALOG=hive
PLEXUS_TRINO_USER=studio

# --- Neo4j (graph source / NL→Cypher) ---
PLEXUS_NEO4J_URI=bolt://localhost:7687
PLEXUS_NEO4J_USER=neo4j
PLEXUS_NEO4J_PASSWORD=
PLEXUS_NEO4J_DATABASE=neo4j

# --- Elasticsearch (SIEM logs source) ---
PLEXUS_ELASTIC_URL=http://localhost:9200

# ============================================================================
# MCP servers (Data-Ops nodes: dbt + Kestra, plus secintel/geoip).
# ADMIN ALLOW-LIST: only listed servers/tools are reachable. JSON on one line.
# Use ABSOLUTE paths. The per-server "env" block is passed to the subprocess.
# Each server runs LIVE when its env vars are set, else returns simulated data.
#   dbt    -> DBT_PROJECT_DIR (+ DBT_PROFILES_DIR, DBT_TARGET)   real local dbt project
#   kestra -> KESTRA_BASE_URL (+ KESTRA_NAMESPACE / token / basic auth)  real Kestra
# Full reference: mcp_servers/README.md and docs/GO-LIVE.md §6.
# ============================================================================
PLEXUS_MCP_SERVERS={"dbt":{"label":"dbt","transport":"stdio","command":"/abs/plexus/backend/.venv/bin/python","args":["/abs/plexus/backend/mcp_servers/dbt_server.py"],"tools":["list_models","model_lineage","dbt_test","dbt_run"],"write_tools":["dbt_run"],"env":{"DBT_PROJECT_DIR":"/abs/your/dbt_project","DBT_TARGET":"dev"}},"kestra":{"label":"Kestra","transport":"stdio","command":"/abs/plexus/backend/.venv/bin/python","args":["/abs/plexus/backend/mcp_servers/kestra_server.py"],"tools":["list_flows","flow_status","trigger_flow"],"write_tools":["trigger_flow"],"env":{"KESTRA_BASE_URL":"http://localhost:8080","KESTRA_NAMESPACE":"company.team"}}}
